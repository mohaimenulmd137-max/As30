/* =========================================================
   4. RENDER LOOP
   ========================================================= */
let playT = 0, playing = false, rafId = null, lastTs = 0, recording = false;

function draw(){
  if(!cv.width || !cv.height) return;
  ctx.setTransform(1,0,0,1,0,0);
  ctx.fillStyle = '#000';
  ctx.fillRect(0,0,OUT_W,OUT_H);

  const t = playT, mt = t - state.start;
  const tpl = TPL[state.template];
  const isKB = state.template === 'kenburns';
  const ov = state.template === 'lowerthird' ? state.overlay*0.65
           : state.template === 'split' ? 0.28
           : state.template === 'quote' ? 0.58 : state.overlay;

  drawBG(t, isKB, ov);

  // Map template's 1280×720 space into OUT area (contain-fit)
  const tScale = Math.min(OUT_W / W, OUT_H / H);
  const tOx = (OUT_W - W * tScale) / 2;
  const tOy = (OUT_H - H * tScale) / 2;

  ctx.save();
  ctx.translate(tOx, tOy);
  ctx.scale(tScale, tScale);
  ctx.translate(W/2 + state.groupX*S, H/2 + state.groupY*S);
  ctx.scale(state.groupScale, state.groupScale);
  ctx.translate(-W/2, -H/2);
  if(tpl) tpl.render(t, mt);
  ctx.restore();
}

function updateScrub(){
  $('scrub').value = String(Math.round((playT / Math.max(0.001, state.total)) * 1000));
  $('timeLabel').textContent = playT.toFixed(2) + 's / ' + state.total.toFixed(2) + 's';
}

function loop(ts){
  if(!playing) return;
  if(!lastTs) lastTs = ts;
  const dt = Math.min(0.1, (ts - lastTs)/1000);
  lastTs = ts; playT += dt;
  if(playT >= state.total){ playT = state.total; playing = false; setPlayLabel(); }
  draw(); updateScrub();
  if(playing) rafId = requestAnimationFrame(loop);
}

function play(){ if(recording) return; if(playT >= state.total-0.001) playT = 0; playing = true; lastTs = 0; setPlayLabel(); cancelAnimationFrame(rafId); rafId = requestAnimationFrame(loop); }
function pause(){ playing = false; setPlayLabel(); cancelAnimationFrame(rafId); }
function setPlayLabel(){ $('play').textContent = playing ? '⏸ পজ' : '▶ প্লে'; }
function nextStep(){
  if(recording) return; pause();
  const first = state.start+0.55, st = Math.max(0.05,state.stagger);
  const nt = playT < first-0.02 ? first : first + (Math.floor((playT-first)/st)+1)*st;
  playT = Math.min(nt,state.total); draw(); updateScrub();
}
function resetAll(){ if(recording) return; pause(); playT = 0; draw(); updateScrub(); }

/* =========================================================
   5. TOUCH DRAG & PINCH
   ========================================================= */
let dragging=false, sx=0, sy=0, igx=0, igy=0, pinchDist0=0, scale0=1;

function clientToTemplateScale(){
  const rect = cv.getBoundingClientRect();
  if(!rect.width) return 1;
  const tScale = Math.min(OUT_W/W, OUT_H/H);
  return (OUT_W / rect.width) / (S * tScale);
}

cv.addEventListener('pointerdown', e=>{
  if(recording) return;
  dragging = true; sx = e.clientX; sy = e.clientY;
  igx = state.groupX; igy = state.groupY;
  try{ cv.setPointerCapture(e.pointerId); }catch(_){}
});

cv.addEventListener('pointermove', e=>{
  if(!dragging || pinchDist0 > 0) return;
  const f = clientToTemplateScale();
  state.groupX = Math.round(clamp(igx + (e.clientX-sx)*f, -640, 640));
  state.groupY = Math.round(clamp(igy + (e.clientY-sy)*f, -360, 360));
  syncTransformLabels();
  if(!playing) draw();
});

cv.addEventListener('pointerup', e=>{
  dragging = false;
  try{ cv.releasePointerCapture(e.pointerId); }catch(_){}
});

cv.addEventListener('touchstart', e=>{
  if(e.touches.length===2){
    dragging = false;
    pinchDist0 = Math.hypot(e.touches[0].clientX-e.touches[1].clientX, e.touches[0].clientY-e.touches[1].clientY);
    scale0 = state.groupScale;
  }
}, { passive:true });

cv.addEventListener('touchmove', e=>{
  if(e.touches.length===2 && pinchDist0>0){
    const d = Math.hypot(e.touches[0].clientX-e.touches[1].clientX, e.touches[0].clientY-e.touches[1].clientY);
    state.groupScale = parseFloat(clamp(scale0*(d/pinchDist0), 0.3, 3).toFixed(2));
    syncTransformLabels();
    if(!playing) draw();
  }
}, { passive:true });

cv.addEventListener('touchend', ()=>{ pinchDist0 = 0; });

function syncTransformLabels(){
  $('groupScale').value = state.groupScale;
  $('scVal').textContent = Math.round(state.groupScale*100)+'%';
  $('groupX').value = state.groupX; $('gxVal').textContent = state.groupX;
  $('groupY').value = state.groupY; $('gyVal').textContent = state.groupY;
}

/* =========================================================
   6. LINE SIZE QUICK LIST (per-line sliders)
   ========================================================= */
function buildLineSizeList(){
  const titleBox = $('lineSizeTitle');
  const itemsBox = $('lineSizeItems');
  titleBox.innerHTML = '';
  itemsBox.innerHTML = '';

  const makeRow = (id, label) => {
    const el = getEl(id);
    const row = document.createElement('div');
    row.className = 'line-size-row';
    row.innerHTML = `
      <span class="lbl">${label}</span>
      <input type="range" data-el="${id}" min="0.4" max="3" step="0.05" value="${el.scale}">
      <span class="val" data-val="${id}">${Math.round(el.scale*100)}%</span>
      <button data-dec="${id}" title="ছোট">−</button>
      <button data-inc="${id}" title="বড়">+</button>
    `;
    return row;
  };

  titleBox.appendChild(makeRow('title', 'শিরোনাম'));
  titleBox.appendChild(makeRow('subtitle', 'সাবটাইটেল'));

  const itemLines = lines(state.items);
  if(!itemLines.length){
    itemsBox.innerHTML = '<div class="hint">এই টেমপ্লেটে লাইন নেই</div>';
  } else {
    itemLines.forEach((ln, i) => {
      if(i > 8) return;
      const preview = ln.length > 14 ? ln.slice(0,14)+'…' : ln;
      itemsBox.appendChild(makeRow('item'+i, preview));
    });
  }

  // Event delegation
  [titleBox, itemsBox].forEach(box => {
    box.querySelectorAll('input[data-el]').forEach(inp => {
      inp.addEventListener('input', () => {
        const id = inp.dataset.el;
        getEl(id).scale = parseFloat(inp.value);
        box.querySelector(`[data-val="${id}"]`).textContent = Math.round(getEl(id).scale*100)+'%';
        draw();
      });
    });
    box.querySelectorAll('button[data-inc]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.inc;
        const el = getEl(id);
        el.scale = Math.min(3, el.scale + 0.1);
        const inp = box.querySelector(`input[data-el="${id}"]`);
        if(inp) inp.value = el.scale;
        box.querySelector(`[data-val="${id}"]`).textContent = Math.round(el.scale*100)+'%';
        draw();
      });
    });
    box.querySelectorAll('button[data-dec]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.dec;
        const el = getEl(id);
        el.scale = Math.max(0.4, el.scale - 0.1);
        const inp = box.querySelector(`input[data-el="${id}"]`);
        if(inp) inp.value = el.scale;
        box.querySelector(`[data-val="${id}"]`).textContent = Math.round(el.scale*100)+'%';
        draw();
      });
    });
  });
}

/* =========================================================
   7. UI BUILDING & BINDING
   ========================================================= */
function buildTemplateGrid(){
  const grid = $('tplGrid');
  grid.innerHTML = '';
  Object.keys(TPL).forEach(key=>{
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'tpl-card' + (state.template === key ? ' active' : '');
    b.textContent = TPL[key].label;
    b.onclick = ()=>{
      document.querySelectorAll('.tpl-card').forEach(x=>x.classList.remove('active'));
      b.classList.add('active');
      state.template = key;
      $('tplBadge').textContent = key;
      const s = TPL[key].sample;
      if(s){
        state.title = s.title ?? '';
        state.subtitle = s.subtitle ?? '';
        state.items = s.items ?? '';
        syncUIFromState();
      }
      resetAll();
    };
    grid.appendChild(b);
  });
}

function syncUIFromState(){
  $('title').value = state.title;
  $('subtitle').value = state.subtitle;
  $('items').value = state.items;
  $('fontFamily').value = state.fontFamily;
  $('fontScale').value = state.fontScale;
  $('fsVal').textContent = Math.round(state.fontScale*100)+'%';
  $('accent').value = state.accent;
  $('textColor').value = state.textColor;
  $('overlay').value = state.overlay;
  $('ovVal').textContent = Math.round(state.overlay*100)+'%';
  $('total').value = state.total;
  $('start').value = state.start;
  $('motionDur').value = state.motionDur;
  $('stagger').value = state.stagger;
  $('fps').value = state.fps;
  $('aspectRatio').value = state.aspectRatio;
  $('aspectQuick').value = state.aspectRatio;
  $('quality').value = state.quality;
  $('tplBadge').textContent = state.template;
  syncTransformLabels();
  syncElLabels();
  buildLineSizeList();
}

function syncElLabels(){
  const target = $('elTarget').value;
  const el = getEl(target);
  $('elDx').value = el.dx; $('elDxVal').textContent = el.dx;
  $('elDy').value = el.dy; $('elDyVal').textContent = el.dy;
  $('elScale').value = el.scale; $('elScaleVal').textContent = Math.round(el.scale*100)+'%';
  $('elColor').value = el.color || '#ffffff';
}

function bind(){
  document.querySelectorAll('.tab-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      document.querySelectorAll('.tab-btn').forEach(x=>x.classList.remove('active'));
      document.querySelectorAll('.pane').forEach(x=>x.classList.remove('active'));
      btn.classList.add('active');
      $('pane-' + btn.dataset.tab).classList.add('active');
    });
  });

  $('fontFamily').addEventListener('change', e=>{ state.fontFamily = e.target.value; draw(); });
  $('fontScale').addEventListener('input', e=>{
    state.fontScale = parseFloat(e.target.value);
    $('fsVal').textContent = Math.round(state.fontScale*100)+'%';
    draw();
  });

  $('groupScale').addEventListener('input', e=>{ state.groupScale = parseFloat(e.target.value); syncTransformLabels(); draw(); });
  $('groupX').addEventListener('input', e=>{ state.groupX = parseFloat(e.target.value); syncTransformLabels(); draw(); });
  $('groupY').addEventListener('input', e=>{ state.groupY = parseFloat(e.target.value); syncTransformLabels(); draw(); });
  $('resetTransform').addEventListener('click', ()=>{
    state.groupX = 0; state.groupY = 0; state.groupScale = 1;
    syncTransformLabels(); draw(); setStatus('🔄 গ্রুপ রিসেট');
  });

  $('elTarget').addEventListener('change', ()=> syncElLabels());
  $('elDx').addEventListener('input', e=>{ getEl($('elTarget').value).dx = parseFloat(e.target.value); syncElLabels(); draw(); });
  $('elDy').addEventListener('input', e=>{ getEl($('elTarget').value).dy = parseFloat(e.target.value); syncElLabels(); draw(); });
  $('elScale').addEventListener('input', e=>{ getEl($('elTarget').value).scale = parseFloat(e.target.value); syncElLabels(); draw(); });
  $('elColor').addEventListener('input', e=>{ getEl($('elTarget').value).color = e.target.value; draw(); });
  $('elReset').addEventListener('click', ()=>{
    const el = getEl($('elTarget').value); el.dx = 0; el.dy = 0; el.scale = 1;
    syncElLabels(); draw(); setStatus('🔄 এলিমেন্ট রিসেট');
  });
  $('elClearColor').addEventListener('click', ()=>{
    getEl($('elTarget').value).color = null; syncElLabels(); draw(); setStatus('🎨 রঙ ক্লিয়ার');
  });
  $('elAllReset').addEventListener('click', ()=>{
    state.el = {}; syncElLabels(); buildLineSizeList(); draw(); setStatus('🔄 সব এলিমেন্ট রিসেট');
  });

  $('resetAllLines').addEventListener('click', ()=>{
    state.el = {}; buildLineSizeList(); draw(); setStatus('🔄 সব লাইন 100%');
  });

  $('title').addEventListener('input', e=>{ state.title = e.target.value; buildLineSizeList(); draw(); });
  $('subtitle').addEventListener('input', e=>{ state.subtitle = e.target.value; draw(); });
  $('items').addEventListener('input', e=>{ state.items = e.target.value; buildLineSizeList(); draw(); });

  $('accent').addEventListener('input', e=>{ state.accent = e.target.value; draw(); });
  $('textColor').addEventListener('input', e=>{ state.textColor = e.target.value; draw(); });
  $('overlay').addEventListener('input', e=>{
    state.overlay = parseFloat(e.target.value);
    $('ovVal').textContent = Math.round(state.overlay*100)+'%';
    draw();
  });

  $('total').addEventListener('change', e=>{
    state.total = Math.max(1, parseFloat(e.target.value)||9);
    e.target.value = state.total; playT = Math.min(playT,state.total);
    draw(); updateScrub();
  });
  $('start').addEventListener('change', e=>{ state.start = Math.max(0, parseFloat(e.target.value)||0); e.target.value = state.start; draw(); });
  $('motionDur').addEventListener('change', e=>{ state.motionDur = Math.max(0.5, parseFloat(e.target.value)||9); e.target.value = state.motionDur; draw(); });
  $('stagger').addEventListener('change', e=>{ state.stagger = Math.max(0.05, parseFloat(e.target.value)||0.55); e.target.value = state.stagger; draw(); });
  $('fps').addEventListener('change', e=>{ state.fps = parseInt(e.target.value,10); });

  function applyAspect(){
    computeOutputSize();
    layoutCanvas();
    updateScrub();
    setStatus(`📐 ${state.aspectRatio} · ${state.quality}`);
  }
  $('aspectRatio').addEventListener('change', e=>{
    state.aspectRatio = e.target.value;
    $('aspectQuick').value = state.aspectRatio;
    applyAspect();
  });
  $('aspectQuick').addEventListener('change', e=>{
    state.aspectRatio = e.target.value;
    $('aspectRatio').value = state.aspectRatio;
    applyAspect();
  });
  $('quality').addEventListener('change', e=>{
    state.quality = e.target.value;
    applyAspect();
  });

  $('play').addEventListener('click', ()=> playing ? pause() : play());
  $('next').addEventListener('click', nextStep);
  $('reset').addEventListener('click', resetAll);

  $('scrub').addEventListener('input', e=>{
    pause();
    playT = (parseInt(e.target.value,10)/1000) * state.total;
    draw(); updateScrub();
  });

  $('bgFile').addEventListener('change', e=>{
    const f = e.target.files && e.target.files[0];
    if(!f) return;
    const rawUrl = URL.createObjectURL(f);
    const img = new Image();
    img.onload = ()=>{
      if(state.bgUrl) URL.revokeObjectURL(state.bgUrl);
      state.bgUrl = URL.createObjectURL(f);
      const finalImg = new Image();
      finalImg.onload = ()=>{
        state.bg = finalImg;
        URL.revokeObjectURL(rawUrl);
        draw();
        setStatus('✅ ইমেজ লোড (মূল মান — ব্লার নেই)');
      };
      finalImg.src = state.bgUrl;
    };
    img.onerror = ()=> setStatus('❌ ইমেজ লোড হয়নি', true);
    img.src = rawUrl;
    e.target.value = '';
  });

  $('clearBg').addEventListener('click', ()=>{
    state.bg = null;
    if(state.bgUrl){ URL.revokeObjectURL(state.bgUrl); state.bgUrl = null; }
    draw(); setStatus('ইমেজ মুছে ফেলা হয়েছে');
  });

  $('loadSample').addEventListener('click', ()=>{
    const s = TPL[state.template].sample;
    if(s){
      state.title = s.title ?? state.title;
      state.subtitle = s.subtitle ?? state.subtitle;
      state.items = s.items ?? state.items;
      syncUIFromState(); draw(); setStatus('↺ ডিফল্ট ডেটা');
    }
  });

  $('download').addEventListener('click', startRecording);
  window.addEventListener('resize', layoutCanvas);
  if(window.ResizeObserver){ new ResizeObserver(layoutCanvas).observe($('stageWrap')); }
}

function setStatus(msg, isErr){
  const el = $('status');
  el.textContent = msg;
  el.className = 'status-bar' + (isErr ? ' err' : '');
}

/* =========================================================
   8. EXPORT
   ========================================================= */
function pickMime(){
  const c = ['video/mp4;codecs=avc1.42E01E','video/mp4','video/webm;codecs=vp9','video/webm;codecs=vp8','video/webm'];
  if(!window.MediaRecorder) return '';
  for(const m of c){ try{ if(MediaRecorder.isTypeSupported(m)) return m; }catch(_){} }
  return '';
}

async function startRecording(){
  if(recording) return;
  const mime = pickMime();
  if(!mime || !cv.captureStream){ setStatus('❌ এই ব্রাউজারে ভিডিও রেকর্ডিং নেই', true); return; }
  recording = true; pause();
  ['download','play','next','reset'].forEach(id=> $(id).disabled = true);
  playT = 0; draw(); updateScrub();

  const stream = cv.captureStream(state.fps);
  const bitrate = Math.max(6_000_000, OUT_W * OUT_H * 4);
  let rec;
  try{ rec = new MediaRecorder(stream, { mimeType: mime, videoBitsPerSecond: bitrate }); }
  catch(err){ setStatus('❌ রেকর্ডার ত্রুটি: '+err.message, true); finishRecording(); return; }

  const chunks = [];
  rec.ondataavailable = e => { if(e.data && e.data.size) chunks.push(e.data); };
  const stopped = new Promise(r => { rec.onstop = r; });
  rec.start(150);
  const t0 = performance.now(), total = state.total;

  await new Promise(resolve=>{
    function frame(){
      const el = (performance.now()-t0)/1000;
      playT = Math.min(el, total);
      draw(); updateScrub();
      setStatus(`⏺ রেকর্ডিং ${OUT_W}×${OUT_H}… ${playT.toFixed(1)}/${total.toFixed(1)}s`);
      if(el >= total){ resolve(); return; }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  });

  await new Promise(r=>setTimeout(r, 350));
  try{ rec.stop(); }catch(_){}
  await stopped;

  const baseType = mime.split(';')[0];
  const blob = new Blob(chunks, { type: baseType });
  chunks.length = 0;
  const ext = baseType.includes('mp4') ? 'mp4' : 'webm';
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `motion-${state.template}-${state.aspectRatio.replace(':','x')}-${state.quality}-${Date.now()}.${ext}`;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  setTimeout(()=> URL.revokeObjectURL(url), 5000);

  setStatus(`✅ ডাউনলোড ${OUT_W}×${OUT_H} (.${ext}, ${(blob.size/1048576).toFixed(1)} MB)`);
  finishRecording();
  playT = 0; draw(); updateScrub();
}

function finishRecording(){
  recording = false;
  ['download','play','next','reset'].forEach(id=> $(id).disabled = false);
}

/* =========================================================
   9. BOOT
   ========================================================= */
function boot(){
  layoutCanvas();
  buildTemplateGrid();
  syncUIFromState();
  bind();
  draw(); updateScrub();
  if(document.fonts && document.fonts.ready){ document.fonts.ready.then(()=> draw()); }
}
boot();
</script>
