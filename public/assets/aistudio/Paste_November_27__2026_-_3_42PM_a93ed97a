typewriter:{label:'১৭. টাইপরাইটার',sample:{title:'তথ্যই শক্তি — সংখ্যাই গল্প বলে।',subtitle:'',items:''},
  render(t,mt){
    const full = state.title || ''; if(!full) return;
    const typedLen = Math.min(full.length,Math.floor(mt*20));
    const el = getEl('title');
    const maxW = W-480*S; const fs = Math.round(48*S*el.scale*state.fontScale);
    const lineH = fs*1.55;
    ctx.font = `700 ${fs}px ${state.fontFamily}`;
    const wrapped = wrapText(full,maxW); const totalH = wrapped.length*lineH;
    const startY = H/2-totalH/2+fs/2;
    ctx.font = `800 ${Math.round(fs*3)}px Georgia,serif`;
    ctx.fillStyle='rgba(255,209,102,.28)'; ctx.textAlign='left'; ctx.textBaseline='alphabetic';
    ctx.fillText('\u201C',W/2-maxW/2-80*S+el.dx*S,startY+fs*0.5+el.dy*S);
    ctx.font = `700 ${fs}px ${state.fontFamily}`;
    ctx.textAlign='center'; ctx.textBaseline='middle';
    ctx.fillStyle = el.color || state.textColor;
    let rem = typedLen;
    wrapped.forEach((ln,i)=>{
      if(rem<=0) return;
      const showLen = Math.min(rem,ln.length);
      ctx.fillText(ln.slice(0,showLen),W/2+el.dx*S,startY+i*lineH+el.dy*S);
      rem -= ln.length;
    });
    if(typedLen<full.length && Math.floor(mt*2.5)%2===0){
      let cl=typedLen, cx=W/2, cy=startY;
      for(let i=0;i<wrapped.length;i++){
        const ll = wrapped[i].length;
        if(cl<=ll){ const lw=ctx.measureText(wrapped[i]).width; const sw=ctx.measureText(wrapped[i].slice(0,cl)).width; cx=W/2-lw/2+sw; cy=startY+i*lineH; break; }
        cl -= ll;
      }
      ctx.fillStyle=state.accent;
      ctx.fillRect(cx+3*S+el.dx*S,cy-fs*0.4+el.dy*S,3*S,fs*0.8);
    }
  }},

timeline:{label:'১৮. টাইমলাইন',sample:{title:'টাইমলাইন',subtitle:'',items:'১৯৩০:শুরু\n২০৩০:লক্ষ্য'},
  render(t,mt){
    const points = lines(state.items).map(l=>{ const p=l.split(/[:：]/); return {year:(p[0]||'').trim(),label:(p[1]||'').trim()}; }).filter(p=>p.year).slice(0,4);
    if(!points.length) return;
    withAnim(mt,0,0.6,p=>{
      txtEl('title',state.title,120*S,170*S,52*S,800);
      const el = getEl('title'); ctx.fillStyle=state.accent;
      rr(ctx,120*S+el.dx*S,196*S+el.dy*S,140*S*p,6*S,3*S); ctx.fill();
    });
    const cy = H/2+60*S, lineW = W-400*S, lineX = W/2-lineW/2;
    const lp = easeOutCubic(clamp((mt-0.3)/0.8));
    if(lp>0){
      ctx.strokeStyle='rgba(255,255,255,.15)'; ctx.lineWidth=4*S; ctx.lineCap='round';
      ctx.beginPath(); ctx.moveTo(lineX,cy); ctx.lineTo(lineX+lineW,cy); ctx.stroke();
      const g = ctx.createLinearGradient(lineX,0,lineX+lineW,0);
      g.addColorStop(0,state.accent); g.addColorStop(1,'#7ee0ff');
      ctx.strokeStyle=g; ctx.beginPath(); ctx.moveTo(lineX,cy); ctx.lineTo(lineX+lineW*lp,cy); ctx.stroke();
    }
    points.forEach((pt,i)=>{
      const ratio = points.length===1?0.5:i/(points.length-1);
      const px = lineX+lineW*ratio;
      const pp = easeOutBack(clamp((mt-0.5-i*0.25)/0.6)); if(pp<=0) return;
      ctx.save(); ctx.globalAlpha = clamp(pp*1.5);
      ctx.beginPath(); ctx.arc(px,cy,14*S*pp,0,Math.PI*2); ctx.fillStyle='rgba(255,209,102,.25)'; ctx.fill();
      ctx.beginPath(); ctx.arc(px,cy,10*S*pp,0,Math.PI*2); ctx.fillStyle=state.accent; ctx.fill();
      ctx.beginPath(); ctx.arc(px,cy,5*S*pp,0,Math.PI*2); ctx.fillStyle='#0b0f18'; ctx.fill();
      ctx.font=F(40*S,800); ctx.fillStyle=state.textColor; ctx.textAlign='center'; ctx.textBaseline='alphabetic';
      ctx.fillText(pt.year,px,cy-42*S);
      if(pt.label){ ctx.font=F(22*S,600); ctx.fillStyle='rgba(255,255,255,.65)'; ctx.textBaseline='top'; ctx.fillText(pt.label,px,cy+34*S); }
      ctx.restore();
    });
  }},

