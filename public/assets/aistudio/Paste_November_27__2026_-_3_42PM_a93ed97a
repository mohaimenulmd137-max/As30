      ctx.fillStyle = colors[i%colors.length]; ctx.fill();
      angle += slice;
    });
    withAnim(mt,0,0.6,p=>{ txtEl('title',state.title,W/2,140*S,54*S,800,'center','middle'); });
    let lx = W/2+300*S, ly = 300*S;
