<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no" />
<title>Motion Studio Pro</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Galada&family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;600;800&family=Noto+Sans+Bengali:wght@400;600;700;800&family=Tiro+Bangla&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
  html,body{height:100dvh;overflow:hidden}
  body{background:#06080d;color:#eef2f7;font-family:'Hind Siliguri','Noto Sans Bengali','Inter',sans-serif;display:flex;flex-direction:column;user-select:none;}
  .topbar{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px 12px;background:#0b0e14;border-bottom:1px solid #1b2230;z-index:20;}
  .brand{display:flex;align-items:center;gap:8px;min-width:0;flex-wrap:wrap}
  .brand h1{font-size:15px;font-weight:700;white-space:nowrap}
  .brand h1 span{color:#ffd166}
  .badge{font-size:10.5px;color:#ffd166;background:#221c0e;border:1px solid #4d3d19;padding:2px 8px;border-radius:99px;white-space:nowrap;}
  .badge-info{font-size:10px;color:#7dd3fc;background:#0e2233;border:1px solid #1e4a6b;padding:2px 8px;border-radius:99px;white-space:nowrap;}
  .top-actions{display:flex;align-items:center;gap:6px}
  .mini-btn{background:#151b26;border:1px solid #253044;color:#dce4f2;padding:6px 10px;border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;}
  .mini-btn:active{transform:scale(.97)}
  .btn-export{background:linear-gradient(135deg,#ffd166,#f59e0b);color:#090b10;border:none;padding:6px 12px;border-radius:7px;font-size:12px;font-weight:800;cursor:pointer;}
  .btn-export:disabled{opacity:.45;cursor:not-allowed}
  .stagewrap{flex:1;min-height:120px;display:flex;justify-content:center;align-items:center;padding:8px 12px;background:radial-gradient(circle at 50% 10%,#121a2d 0%,#06080d 75%);position:relative;overflow:hidden;}
  canvas{max-width:100%;max-height:100%;border-radius:10px;background:#000;box-shadow:0 16px 40px -12px rgba(0,0,0,.9),0 0 0 1px #1c2434;touch-action:none;display:block;image-rendering:auto;}
  .tip{position:absolute;top:14px;left:50%;transform:translateX(-50%);background:rgba(10,14,22,.72);border:1px solid rgba(255,255,255,.12);color:#b8c4d8;font-size:11px;padding:3px 10px;border-radius:99px;pointer-events:none;white-space:nowrap;z-index:5;}
  .status-bar{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);background:rgba(10,14,22,.9);border:1px solid #2b3850;color:#8ef0ab;font-size:11.5px;padding:4px 12px;border-radius:99px;pointer-events:none;max-width:92%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;z-index:5;}
  .status-bar.err{color:#ff8b8b;border-color:#6b2b2b}
  .timeline{background:#0b0e14;border-top:1px solid #1b2230;padding:6px 12px;display:flex;flex-direction:column;gap:6px;}
  .scrub-row{display:flex;align-items:center;gap:10px}
  .scrub-row input[type=range]{flex:1;height:5px;accent-color:#ffd166;cursor:pointer}
  .time-txt{font-size:11.5px;color:#9aa7bc;font-variant-numeric:tabular-nums;min-width:88px;text-align:right}
  .transport{display:flex;align-items:center;justify-content:center;gap:12px}
  .t-btn{background:#151b26;border:1px solid #253044;color:#e7ecf5;padding:6px 14px;border-radius:8px;font-size:12.5px;font-weight:700;cursor:pointer;}
  .t-btn.play{background:#ffd166;color:#080a0f;border:none;padding:6px 20px}
  .t-btn:disabled{opacity:.45;cursor:not-allowed}
  .dock{height:270px;background:#0d1118;border-top:1px solid #1b2230;display:flex;flex-direction:column;z-index:20;}
  .tabs{display:flex;overflow-x:auto;background:#090c12;border-bottom:1px solid #1b2230;padding:0 6px;}
  .tabs::-webkit-scrollbar{display:none}
  .tab-btn{background:none;border:none;border-bottom:2px solid transparent;color:#8592a6;padding:9px 12px;font-size:12.5px;font-weight:700;white-space:nowrap;cursor:pointer;font-family:inherit;}
  .tab-btn.active{color:#ffd166;border-bottom-color:#ffd166}
  .tab-panels{flex:1;overflow-y:auto;padding:10px 12px}
  .tab-panels::-webkit-scrollbar{width:6px}
  .tab-panels::-webkit-scrollbar-thumb{background:#232e42;border-radius:6px}
  .pane{display:none}
  .pane.active{display:block}
  .grid-tpl{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:6px}
  .tpl-card{background:#151b26;border:1px solid #232d3e;color:#d6dfed;border-radius:8px;padding:7px;font-size:11px;font-weight:600;text-align:left;cursor:pointer;}
  .tpl-card.active{background:#29210f;border-color:#ffd166;color:#ffd166}
  .field{margin-bottom:9px}
  .field label{display:flex;justify-content:space-between;font-size:11.5px;color:#9aa7bc;margin-bottom:4px;font-weight:600}
  .field label span{color:#ffd166}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
  input[type=text],input[type=number],select,textarea{width:100%;background:#151b26;border:1px solid #253044;color:#eef2f7;border-radius:8px;padding:7px 9px;font-size:12.5px;font-family:inherit;outline:none;user-select:text;}
  input:focus,select:focus,textarea:focus{border-color:#ffd166}
  textarea{resize:vertical;min-height:56px;line-height:1.45}
  input[type=color]{width:100%;height:32px;background:#151b26;border:1px solid #253044;border-radius:7px;padding:2px;cursor:pointer}
  input[type=range]{width:100%;accent-color:#ffd166;cursor:pointer}
  .hint{font-size:10.5px;color:#788599;margin-top:3px;line-height:1.4}
  .hint b{color:#ffd166}
  .action-sm{background:#171f2e;border:1px solid #2a374f;color:#dce5f4;padding:6px 10px;border-radius:7px;font-size:11.5px;font-weight:600;cursor:pointer;}
  .line-size-row{display:grid;grid-template-columns:70px 1fr 44px 26px 26px;gap:5px;align-items:center;padding:3px 0;border-bottom:1px solid #1a2330}
  .line-size-row:last-child{border-bottom:none}
  .line-size-row .lbl{font-size:10.5px;color:#9aa7bc;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .line-size-row .val{font-size:10px;color:#ffd166;font-weight:700;text-align:right}
  .line-size-row button{background:#171f2e;border:1px solid #2a374f;color:#dce5f4;padding:2px 5px;border-radius:5px;font-size:11px;cursor:pointer;line-height:1;height:20px}
  .line-size-row button:active{background:#29210f;color:#ffd166}
  .line-size-row input[type=range]{height:4px;padding:0}
</style>
</head>
<body>

<header class="topbar">
  <div class="brand">
    <h1>Motion <span>Studio</span> Pro</h1>
    <span class="badge" id="tplBadge">stack</span>
    <span class="badge-info" id="resBadge">16:9 · 1080p</span>
  </div>
  <div class="top-actions">
    <input type="file" id="bgFile" accept="image/*" style="display:none">
    <button class="mini-btn" onclick="document.getElementById('bgFile').click()">🖼 ইমেজ</button>
    <button class="mini-btn" id="clearBg">✕</button>
    <button class="btn-export" id="download">⬇ এক্সপোর্ট</button>
  </div>
</header>

<main class="stagewrap" id="stageWrap">
  <div class="tip">✋ সরান · 🤏 জুম · প্রতিটি লাইন আলাদা সাইজ</div>
  <canvas id="stage"></canvas>
  <div class="status-bar" id="status">প্রস্তুত</div>
</main>

<section class="timeline">
  <div class="scrub-row">
    <select id="aspectQuick" style="width:78px;padding:4px 6px;font-size:11px;background:#151b26;border:1px solid #253044;color:#eef2f7;border-radius:6px">
      <option value="16:9">16:9</option>
      <option value="9:16">9:16</option>
      <option value="1:1">1:1</option>
      <option value="4:5">4:5</option>
      <option value="4:3">4:3</option>
      <option value="21:9">21:9</option>
    </select>
    <input type="range" id="scrub" min="0" max="1000" value="0">
    <span class="time-txt" id="timeLabel">0.00s / 9.00s</span>
  </div>
  <div class="transport">
    <button class="t-btn play" id="play">▶ প্লে</button>
    <button class="t-btn" id="next">⏭ নেক্সট</button>
    <button class="t-btn" id="reset">↺ রিসেট</button>
  </div>
</section>

<section class="dock">
  <div class="tabs">
    <button class="tab-btn active" data-tab="tpl">টেমপ্লেট</button>
    <button class="tab-btn" data-tab="text">টেক্সট</button>
    <button class="tab-btn" data-tab="line">লাইন সাইজ</button>
    <button class="tab-btn" data-tab="el">এলিমেন্ট কন্ট্রোল</button>
    <button class="tab-btn" data-tab="transform">গ্রুপ</button>
    <button class="tab-btn" data-tab="timing">টাইমিং ও আউটপুট</button>
  </div>

  <div class="tab-panels">
    <div class="pane active" id="pane-tpl">
      <div class="grid-tpl" id="tplGrid"></div>
      <div style="margin-top:8px;display:flex;gap:8px">
        <button class="action-sm" id="loadSample">↺ ডিফল্ট ডেটা</button>
      </div>
    </div>

    <div class="pane" id="pane-text">
      <div class="row2">
        <div class="field">
          <label>ফন্ট</label>
          <select id="fontFamily">
            <option value="'Hind Siliguri','Noto Sans Bengali',sans-serif">Hind Siliguri</option>
            <option value="'Noto Sans Bengali','Hind Siliguri',sans-serif">Noto Sans</option>
            <option value="'Tiro Bangla','Hind Siliguri',serif">Tiro Bangla</option>
            <option value="'Galada','Hind Siliguri',cursive">Galada</option>
            <option value="'Inter','Hind Siliguri',sans-serif">Inter</option>
          </select>
        </div>
        <div class="field">
          <label>গ্লোবাল ফন্ট <span id="fsVal">100%</span></label>
          <input type="range" id="fontScale" min="0.4" max="2.5" step="0.05" value="1">
        </div>
      </div>
      <div class="field">
        <label>শিরোনাম / Title</label>
        <input type="text" id="title">
        <div class="hint">হাইলাইটারে <b>*শব্দ*</b> = মার্কার</div>
      </div>
      <div class="field">
        <label>সাবটাইটেল</label>
        <input type="text" id="subtitle">
      </div>
      <div class="field">
        <label>লাইন (প্রতি লাইনে একটি)</label>
        <textarea id="items" rows="3"></textarea>
      </div>
    </div>

    <div class="pane" id="pane-line">
      <div class="hint" style="margin-bottom:8px">প্রতিটি লাইনের সাইজ আলাদা বদলান। ↺ = রিসেট।</div>
      <div class="field">
        <div style="display:flex;justify-content:space-between;margin-bottom:4px">
          <label style="color:#ffd166">শিরোনাম ও সাবটাইটেল</label>
        </div>
        <div id="lineSizeTitle"></div>
      </div>
      <div class="field">
        <label>লাইনগুলো (আইটেম)</label>
        <div id="lineSizeItems"></div>
      </div>
      <button class="action-sm" id="resetAllLines">🔄 সব লাইন 100%</button>
    </div>

    <div class="pane" id="pane-el">
      <div class="field">
        <label>কোন এলিমেন্ট</label>
        <select id="elTarget">
          <option value="title">শিরোনাম (Title)</option>
          <option value="subtitle">সাবটাইটেল</option>
          <option value="items">সব লাইন (গ্রুপ)</option>
          <option value="item0">লাইন ১</option>
          <option value="item1">লাইন ২</option>
          <option value="item2">লাইন ৩</option>
          <option value="item3">লাইন ৪</option>
          <option value="item4">লাইন ৫</option>
          <option value="item5">লাইন ৬</option>
        </select>
      </div>
      <div class="row2">
        <div class="field">
          <label>X <span id="elDxVal">0</span></label>
          <input type="range" id="elDx" min="-600" max="600" step="5" value="0">
        </div>
        <div class="field">
          <label>Y <span id="elDyVal">0</span></label>
          <input type="range" id="elDy" min="-400" max="400" step="5" value="0">
        </div>
      </div>
      <div class="row2">
        <div class="field">
          <label>সাইজ <span id="elScaleVal">100%</span></label>
          <input type="range" id="elScale" min="0.3" max="3" step="0.05" value="1">
        </div>
        <div class="field">
          <label>রঙ</label>
          <input type="color" id="elColor" value="#ffffff">
        </div>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button class="action-sm" id="elReset">🔄 এই এলিমেন্ট</button>
        <button class="action-sm" id="elClearColor">🎨 রঙ ক্লিয়ার</button>
        <button class="action-sm" id="elAllReset">🔄 সব এলিমেন্ট</button>
      </div>
    </div>

    <div class="pane" id="pane-transform">
      <div class="field">
        <label>গ্রুপ সাইজ <span id="scVal">100%</span></label>
        <input type="range" id="groupScale" min="0.3" max="3" step="0.05" value="1">
      </div>
      <div class="row2">
        <div class="field">
          <label>X <span id="gxVal">0</span></label>
          <input type="range" id="groupX" min="-640" max="640" step="5" value="0">
        </div>
        <div class="field">
          <label>Y <span id="gyVal">0</span></label>
          <input type="range" id="groupY" min="-360" max="360" step="5" value="0">
        </div>
      </div>
      <button class="action-sm" id="resetTransform">🔄 গ্রুপ রিসেট</button>
    </div>

    <div class="pane" id="pane-timing">
      <div class="row2">
        <div class="field">
          <label>অ্যাসপেক্ট রেশিও</label>
          <select id="aspectRatio">
            <option value="16:9">16:9 (YouTube)</option>
            <option value="9:16">9:16 (Shorts/Reels)</option>
            <option value="1:1">1:1 (Insta Feed)</option>
            <option value="4:5">4:5 (Insta Portrait)</option>
            <option value="4:3">4:3 (Legacy)</option>
            <option value="21:9">21:9 (Cinema)</option>
          </select>
        </div>
        <div class="field">
          <label>রেজোলিউশন</label>
          <select id="quality">
            <option value="480p">480p (দ্রুত)</option>
            <option value="720p">720p HD</option>
            <option value="1080p" selected>1080p Full HD</option>
            <option value="1440p">1440p 2K</option>
            <option value="4K">4K Ultra</option>
          </select>
        </div>
      </div>
      <div class="row2">
        <div class="field"><label>Accent</label><input type="color" id="accent"></div>
        <div class="field"><label>মূল টেক্সট</label><input type="color" id="textColor"></div>
      </div>
      <div class="field">
        <label>ওভারলে <span id="ovVal">45%</span></label>
        <input type="range" id="overlay" min="0" max="0.9" step="0.05">
      </div>
      <div class="row3">
        <div class="field"><label>মোট (s)</label><input type="number" id="total" min="1" max="180" step="0.5"></div>
        <div class="field"><label>শুরু (s)</label><input type="number" id="start" min="0" step="0.1"></div>
        <div class="field"><label>মোশন (s)</label><input type="number" id="motionDur" min="0.5" step="0.5"></div>
      </div>
      <div class="row2">
        <div class="field"><label>স্ট্যাগার (s)</label><input type="number" id="stagger" min="0.05" step="0.05"></div>
        <div class="field">
          <label>FPS</label>
          <select id="fps"><option value="24">24</option><option value="30" selected>30</option><option value="60">60</option></select>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
/* =========================================================
   0. SETUP
   ========================================================= */
const cv  = document.getElementById('stage');
const ctx = cv.getContext('2d');
const W = 1280, H = 720;
const S = W / 1920;
let OUT_W = 1920, OUT_H = 1080;

const $ = id => document.getElementById(id);
const clamp = (v,a=0,b=1) => Math.min(b, Math.max(a, v));
const lerp  = (a,b,t) => a + (b-a)*t;
const easeOutCubic   = x => 1 - Math.pow(1-x,3);
const easeInOutCubic = x => x < .5 ? 4*x*x*x : 1 - Math.pow(-2*x+2,3)/2;
const easeOutBack    = x => { const c1=1.70158, c3=c1+1; return 1 + c3*Math.pow(x-1,3) + c1*Math.pow(x-1,2); };

const ASPECTS = {
  '16:9': [1920, 1080],
  '9:16': [1080, 1920],
  '1:1':  [1080, 1080],
  '4:5':  [1080, 1350],
  '4:3':  [1440, 1080],
  '21:9': [2520, 1080]
};
const QUALITY = { '480p':0.444, '720p':0.667, '1080p':1, '1440p':1.333, '4K':2 };

const state = {
  bg:null, bgUrl:null, template:'stack',
  title:'মোশন ডিজাইন শেখা',
  subtitle:'অধ্যায় ০১ — মূল ধারণা',
  items:'ভূমিকা ও লক্ষ্য নির্ধারণ\nটাইমলাইন ও কীফ্রেম\nইজিং ও স্পিড কার্ভ\nরেন্ডার ও এক্সপোর্ট',
  fontFamily:"'Hind Siliguri','Noto Sans Bengali',sans-serif",
  fontScale:1.0,
  groupX:0, groupY:0, groupScale:1.0,
  accent:'#ffd166', textColor:'#ffffff',
  overlay:0.45, total:9, start:0, motionDur:9, stagger:0.55, fps:30,
  aspectRatio:'16:9', quality:'1080p',
  el: {}
};

function getEl(id){
  if(!state.el[id]) state.el[id] = {dx:0, dy:0, scale:1, color:null};
  return state.el[id];
}

const F = (size, weight=700) =>
  `${weight} ${Math.max(10, Math.round(size * state.fontScale))}px ${state.fontFamily}`;

const lines = s => (s||'').split('\n').map(x=>x.trim()).filter(Boolean);

function rr(c,x,y,w,h,r){
  if(w<0){x+=w;w=-w} if(h<0){y+=h;h=-h}
  r = Math.min(r, Math.abs(w)/2, Math.abs(h)/2);
  c.beginPath(); c.moveTo(x+r,y);
  c.arcTo(x+w,y,x+w,y+h,r); c.arcTo(x+w,y+h,x,y+h,r);
  c.arcTo(x,y+h,x,y,r); c.arcTo(x,y,x+w,y,r); c.closePath();
}

function fitSize(text, maxW, size, weight=600, min=14){
  let s = size * state.fontScale;
  const minS = min * state.fontScale;
  while(s > minS){
    ctx.font = `${weight} ${Math.round(s)}px ${state.fontFamily}`;
    if(ctx.measureText(text).width <= maxW) break;
    s -= 1;
  }
  return Math.round(s / state.fontScale);
}

function wrapText(text, maxW){
  const words = (text||'').split(/\s+/).filter(Boolean);
  const out = []; let cur = '';
  for(const w of words){
    const test = cur ? cur+' '+w : w;
    if(ctx.measureText(test).width > maxW && cur){ out.push(cur); cur = w; }
    else cur = test;
  }
  if(cur) out.push(cur);
  return out.length ? out : [''];
}

function parseMarked(str){
  const parts = []; const re = /\*([^*]+)\*/g;
  let last = 0, m;
  while((m = re.exec(str||''))){
    if(m.index > last) parts.push({ text: str.slice(last, m.index), hl:false });
    parts.push({ text: m[1], hl:true });
    last = re.lastIndex;
  }
  if(last < (str||'').length) parts.push({ text: str.slice(last), hl:false });
  return parts;
}

const BN_DIGITS = ['০','১','২','৩','৪','৫','৬','৭','৮','৯'];
function parseBnNum(str){
  const bnMap = {'০':'0','১':'1','২':'2','৩':'3','৪':'4','৫':'5','৬':'6','৭':'7','৮':'8','৯':'9'};
  const clean = String(str||'').replace(/[০-৯]/g, d => bnMap[d]).replace(/[^\d.-]/g, '');
  return parseFloat(clean) || 0;
}
function fmtBnNum(n){
  const neg = n < 0;
  const abs = Math.abs(Math.round(n));
  const formatted = abs.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  const bn = formatted.split('').map(c => BN_DIGITS[parseInt(c)] ?? c).join('');
  return (neg ? '−' : '') + bn;
}

function txtEl(id, text, x, y, size, weight, align, baseline, defColor){
  const el = getEl(id);
  const s = Math.round(size * el.scale * state.fontScale);
  ctx.font = `${weight} ${s}px ${state.fontFamily}`;
  ctx.fillStyle = el.color || defColor || state.textColor;
  ctx.textAlign = align || 'left';
  ctx.textBaseline = baseline || 'alphabetic';
  ctx.fillText(text, x + el.dx*S, y + el.dy*S);
  return { x: x + el.dx*S, y: y + el.dy*S, w: ctx.measureText(text).width };
}

function txtItem(id, text, x, y, size, weight, align, baseline, defColor){
  const eg = getEl('items');
  const ei = getEl(id);
  const dx = (eg.dx + ei.dx) * S;
  const dy = (eg.dy + ei.dy) * S;
  const sc = eg.scale * ei.scale;
  const s = Math.round(size * sc * state.fontScale);
  ctx.font = `${weight} ${s}px ${state.fontFamily}`;
  ctx.fillStyle = ei.color || eg.color || defColor || state.textColor;
  ctx.textAlign = align || 'left';
  ctx.textBaseline = baseline || 'alphabetic';
  ctx.fillText(text, x + dx, y + dy);
  return { x: x + dx, y: y + dy, w: ctx.measureText(text).width };
}

function withAnim(mt, delay, dur, drawFn){
  const p = easeOutCubic(clamp((mt-delay)/dur));
  if(p <= 0) return;
  ctx.save();
  ctx.globalAlpha *= p;
  drawFn(p);
  ctx.restore();
}

/* =========================================================
   1. CANVAS SIZING & LAYOUT (DPR-aware, aspect-aware)
   ========================================================= */
function computeOutputSize(){
  const [bw, bh] = ASPECTS[state.aspectRatio];
  const q = QUALITY[state.quality];
  OUT_W = Math.floor(bw * q / 2) * 2;
  OUT_H = Math.floor(bh * q / 2) * 2;
  $('resBadge').textContent = state.aspectRatio + ' · ' + state.quality;
}

function layoutCanvas(){
  computeOutputSize();
  cv.width = OUT_W;
  cv.height = OUT_H;
  // Fit visually into stagewrap
  const wrap = $('stageWrap');
  const cw = wrap.clientWidth - 24;
  const ch = wrap.clientHeight - 24;
  const ar = OUT_W / OUT_H;
  let w, h;
  if (cw / ch > ar) { h = ch; w = h * ar; }
  else { w = cw; h = w / ar; }
  cv.style.width = w + 'px';
  cv.style.height = h + 'px';
  draw();
}

/* =========================================================
   2. BACKGROUND (fills OUT area — no blur)
   ========================================================= */
function drawBG(t, kenburns, overlayOverride){
  const ov = overlayOverride === undefined ? state.overlay : overlayOverride;
  if(!state.bg){
    const g = ctx.createLinearGradient(0,0,OUT_W,OUT_H);
    g.addColorStop(0,'#121a2c'); g.addColorStop(.5,'#0b1020'); g.addColorStop(1,'#191126');
    ctx.fillStyle = g; ctx.fillRect(0,0,OUT_W,OUT_H);
    return;
  }
  const img = state.bg;
  const base = Math.max(OUT_W/img.width, OUT_H/img.height);
  const prog = clamp(t / Math.max(0.01, state.total));
  let k = 1, dx = 0, dy = 0;
  if(kenburns){
    k  = 1 + 0.08 * easeInOutCubic(prog);
    dx = -22 * easeInOutCubic(prog);
    dy = -14 * easeInOutCubic(prog);
  }
  const s  = base * k;
  const dw = img.width * s, dh = img.height * s;
  ctx.imageSmoothingEnabled = true;
  ctx.imageSmoothingQuality = 'high';
  ctx.drawImage(img, (OUT_W-dw)/2 + dx, (OUT_H-dh)/2 + dy, dw, dh);
  if(ov > 0){ ctx.fillStyle = `rgba(5,7,12,${ov})`; ctx.fillRect(0,0,OUT_W,OUT_H); }
}

function drawImageInto(x,y,w,h,img){
  if(!img) return;
  const s = Math.max(w/img.width, h/img.height);
  const dw = img.width*s, dh = img.height*s;
  ctx.save();
  rr(ctx,x,y,w,h,10); ctx.clip();
  ctx.imageSmoothingEnabled = true;
  ctx.imageSmoothingQuality = 'high';
  ctx.drawImage(img, x+(w-dw)/2, y+(h-dh)/2, dw, dh);
  ctx.restore();
}

